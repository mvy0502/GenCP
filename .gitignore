# ---- TUBITAK work additions ----
*.tif
!GenCP_HR_demo/data/dataset/test/*.tif
!GenCP_VHR_demo/gencp_VHR_data_test/**/*.tif
**/data/GenCP_DB/
**/data/fake_images/
tubitak/data/*
!tubitak/data/.gitkeep
tubitak/outputs/*
!tubitak/outputs/.gitkeep
# report figures are deliverables: keep them despite the *.png rule above
!tubitak/docs/figures/*.png

# The plugin's toolbar icon is SOURCE, not imagery. metadata.txt names it and
# scripts/build_plugin_zip.py copies it into the archive, so if the *.png rule swallowed
# it a fresh clone would build a zip whose toolbar button is blank - and nothing would
# say so.
!tubitak/qgis_plugin/icon.png

# Plugin screenshots are the deliverable for "show what it actually looks like": dialog
# captures plus canvas renders, produced by tubitak/tests/plugin_e2e_run.py. Cleared
# against the two imagery rules before adding them: the base raster in these renders is
# Sentinel-2 (Copernicus T36TVK, open data - see tubitak/docs/ankara-acquisition.md), the
# rasterised input is our own OSM/CLC+ render, and no institutional or Google Earth
# imagery appears in any of them.
!tubitak/docs/evidence/plugin_screens/*.png
*.pth
*.zip
.venv/
*.egg-info/

# Turkish progress report: source markdown is versioned, rendered PDF and figure
# binaries are reproducible from it and stay out of git (same policy as tubitak/outputs/).
tubitak/rapor2/*.pdf
tubitak/rapor2/gorseller/

# Sonuç raporu: kaynak sürümlenir, PDF ve figürler üretilebilir olduğu için hariç
tubitak/rapor3/*.pdf
tubitak/rapor3/gorseller/

# Yayınlanmış makalenin yerel kopyası (telifli, depoya girmez)
tubitak/data/paper/

# Kişisel/idari belgeler ve oturum notları depoya girmez
tubitak/docs/*.pdf
tubitak/docs/teke-proposal.md
RESUME.md
